    },
    {
      "path": "tests/research-view.test.mjs",
      "reason": "Adds focused coverage for research metadata validation, projections, coverage gaps, and V1/V2 compatibility."
    },
    {
      "path": "tests/revisions.test.mjs",
      "reason": "The stale-recovery contention regression synchronizes both child writers at a start barrier, asserts one successful revision and one explicit losing boundary, and preserves diagnostic child results."
    },
    {
      "path": "tests/diagnostics.test.mjs",
      "reason": "The stale-owner replacement regression injects its competing owner at the atomic hard-link publication boundary used by the adapted revision lock."
    },
    {
