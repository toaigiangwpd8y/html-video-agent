  "adaptedFiles": [
    {
      "path": "lib/store.mjs",
      "reason": "Explicit workspace selection prevents accidental reads or writes of example data; optional revisioned research metadata is validated atomically with feature writes."
    },
    {
      "path": "lib/revisions.mjs",
      "reason": "Revision and recovery lock owner metadata is published atomically through a temporary file and hard link, avoiding a partial-owner read during contention."
    },
    {
      "path": "lib/coverage.mjs",
      "reason": "Research control references are checked against existing contexts, scenarios, open questions, and follow-up tasks."
    },
    {
      "path": "lib/feature-view.mjs",
      "sourceSha256": "d441f2a37cf26a021fccdf5a2a10b3602796a7b5a6972784e288e192aa0a5467",
      "currentSha256": "9b6dcef74fbb1591fc61ee9bfeab20cc5157711271170fe1292c03b65bf75faa",
      "reason": "Feature read models and Markdown exports include research provenance without changing verification status; the local GRA-52 projection adds V1/V2 discovery steps and renders screenshot/snapshot destinations as raw evidence URLs without turning them into verification claims."
    },
    {
      "path": "lib/research-view.mjs",
      "reason": "New derived projection summarizes existing scenario observations, research candidates, controls, and open coverage; it is not a second knowledge authority."
    },
    {
      "path": "index.mjs",
      "reason": "Exports the derived research projection alongside existing App Explorer APIs."
    },
    {
      "path": "index.d.mts",
